{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @softprobe/blackbox hook --agent claude-code"
          }
        ]
      }
    ],
    "PreToolUse": [
